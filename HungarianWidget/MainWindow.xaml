<Window x:Class="HungarianWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Magyar"
        Width="470" Height="485"
        MinWidth="400" MinHeight="450"
        Icon="Content/magyar.ico"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Loaded="Window_Loaded"
        SizeChanged="Window_SizeChanged"
        Closing="Window_Closing">
    <Grid Margin="10">
        <Border x:Name="WidgetBorder" CornerRadius="24"
                Padding="19"
                BorderThickness="1"
                BorderBrush="#53617D"
                Background="#151C2C">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" ShadowDepth="7" Opacity="0.4" Color="#070B13" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="DragHandle" Orientation="Horizontal" VerticalAlignment="Center"
                                Cursor="SizeAll" ToolTip="Drag this title area to move the widget"
                                MouseLeftButtonDown="Header_MouseLeftButtonDown">
                        <TextBlock Text="⠿" Foreground="#B6A8FF" FontSize="17" Margin="0,0,7,0"
                                   FontFamily="Segoe UI Symbol" VerticalAlignment="Center" />
                        <TextBlock x:Name="BrandText" Text="MAGYAR" Foreground="#F6F5FF" FontSize="12" FontWeight="Bold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <Button x:Name="RerollButton" Grid.Column="1" Content="↻  Reroll" Padding="11,7"
                            Margin="0,0,7,0" Click="RerollButton_Click" ToolTip="Show a different card" />
                    <Button x:Name="QuizButton" Grid.Column="2" Content="Quiz" Padding="12,7"
                            Margin="0,0,7,0" Background="#5A4B99" BorderBrush="#796CC0"
                            Click="QuizButton_Click" ToolTip="Take a short quiz" />
                    <Button x:Name="MenuButton" Grid.Column="3" Content="⋯" Padding="9,6"
                            Margin="0,0,5,0" Click="MenuButton_Click" ToolTip="Widget settings" />
                    <Button Grid.Column="4" Content="×" Padding="9,6" Click="HideButton_Click"
                            ToolTip="Hide to the system tray" />
                </Grid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="1,16,0,8" VerticalAlignment="Center">
                    <Border x:Name="BadgeBorder" Background="#2F3357" CornerRadius="9" Padding="9,4">
                        <TextBlock x:Name="BadgeText" Text="NEW WORD" Foreground="#D9D3FF" FontSize="10"
                                   FontWeight="Bold" />
                    </Border>
                    <TextBlock x:Name="TopicText" Text="BASICS" Foreground="#97A2BA" FontSize="10"
                               FontWeight="SemiBold" Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel x:Name="CardContent" Grid.Row="2" VerticalAlignment="Center">
                    <TextBlock Text="WORD" Foreground="#BEB4FF" FontSize="10" FontWeight="Bold" />
                    <TextBlock x:Name="HungarianText" Text="Szia!" Foreground="#FBFAFF" FontSize="31"
                               FontFamily="Segoe UI Variable Display, Segoe UI" FontWeight="SemiBold"
                               TextWrapping="Wrap" MaxHeight="76" LineStackingStrategy="BlockLineHeight"
                               LineHeight="36" Margin="0,5,0,0" />
                    <TextBlock x:Name="EnglishText" Text="Hi! / Bye! (informal)"
                               Foreground="#B7C1D4" FontSize="15" Margin="0,3,0,0"
                               TextWrapping="Wrap" MaxHeight="42" />
                    <Border x:Name="ExampleDivider" Height="1" Background="#39445A" Margin="0,14,0,12" />
                    <TextBlock Text="IN A SENTENCE" Foreground="#97A2BA" FontSize="10" FontWeight="Bold" />
                    <TextBlock x:Name="ExampleHungarianText" Text="Szia! Hogy vagy?" Foreground="#FBFAFF"
                               FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="66"
                               Margin="0,6,0,0" />
                    <TextBlock x:Name="ExampleEnglishText" Text="Hi! How are you?" Foreground="#B7C1D4"
                               FontSize="14" TextWrapping="Wrap" MaxHeight="44" Margin="0,3,0,0" />
                </StackPanel>

                <StackPanel x:Name="EmptyStatePanel" Grid.Row="2" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock x:Name="EmptyTitleText" Text="You're all caught up for now." Foreground="#F6F5FF"
                               FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="EmptyDescriptionText" Text="A few cards will come back for review later."
                               Foreground="#AAB4C8" FontSize="14" Margin="0,9,0,16" TextWrapping="Wrap" />
                    <Button x:Name="NewCycleButton" Content="Start another rotation" HorizontalAlignment="Left" Background="#554A8D"
                            BorderBrush="#786DC0" Click="NewCycleButton_Click" />
                </StackPanel>

                <Grid Grid.Row="3" Margin="0,13,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ListenButton" Content="◖)))  Hear word" Padding="12,8" Margin="0,0,5,0"
                            Background="#2D3852" BorderBrush="#54617A" Click="ListenButton_Click"
                            ToolTip="Hear the Hungarian word" />
                    <Button x:Name="ListenSentenceButton" Grid.Column="1" Content="◖)))  Hear sentence"
                            Padding="12,8" Margin="5,0,0,0" Background="#2D3852" BorderBrush="#54617A"
                            Click="ListenSentenceButton_Click" ToolTip="Hear the example sentence" />
                </Grid>

                <TextBlock x:Name="AudioStatusText" Grid.Row="4" Text="Tap either button to hear Hungarian"
                           Foreground="#8E9BB4" FontSize="10" VerticalAlignment="Center" Margin="2,7,0,0"
                           TextWrapping="Wrap" />

                <Border x:Name="QuizPanel" Grid.Row="5" Visibility="Collapsed" Margin="0,14,0,0"
                        Padding="14" CornerRadius="16" Background="#202A40" BorderBrush="#394660"
                        BorderThickness="1">
                    <StackPanel>
                        <Grid Margin="0,0,0,9">
                            <TextBlock Text="MINI QUIZ" Foreground="#BEB4FF" FontSize="10" FontWeight="Bold"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="QuizCounterText" Text="1 / 3" Foreground="#99A6BF" FontSize="11"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel x:Name="QuizQuestionPanel">
                            <TextBlock x:Name="QuizPromptText" Text="What does this mean?" Foreground="#AAB4C8"
                                       FontSize="12" Margin="0,0,0,5" />
                            <TextBlock x:Name="QuizQuestionText" Text="Szia!" Foreground="#F7F6FF"
                                       FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10" />
                            <StackPanel x:Name="QuizOptionsPanel" />
                            <TextBlock x:Name="QuizFeedbackText" Foreground="#D5D7E2" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,8,0,0" />
                            <Button x:Name="QuizNextButton" Content="Next question  →" IsEnabled="False"
                                    HorizontalAlignment="Right" Margin="0,10,0,0" Click="QuizNextButton_Click" />
                        </StackPanel>
                        <StackPanel x:Name="QuizResultsPanel" Visibility="Collapsed">
                            <TextBlock x:Name="QuizResultText" Text="2 of 3 correct" Foreground="#F7F6FF"
                                       FontSize="21" FontWeight="SemiBold" />
                            <TextBlock x:Name="QuizResultHintText" Text="The missed cards will come back for review."
                                       Foreground="#AAB4C8" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,10" />
                            <Button Content="Another quick quiz" HorizontalAlignment="Left"
                                    Click="QuizAgainButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <Thumb x:Name="ResizeGrip" Width="19" Height="19" Margin="0,0,7,7"
               HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent"
               Cursor="SizeNWSE" DragDelta="ResizeGrip_DragDelta"
               ToolTip="Drag to resize the widget">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent">
                        <Path Data="M 13,3 L 3,13 M 17,3 L 3,17" Stroke="#77839B"
                              StrokeThickness="1.5" StrokeStartLineCap="Round" />
                    </Grid>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>
    </Grid>
</Window>
